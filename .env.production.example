# Referência local. Preencha os valores reais somente no provedor de hospedagem
# ou em um arquivo .env.production ignorado pelo Git.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_por_uma_chave_publica
VITE_SUPABASE_PROJECT_ID=seu-projeto

# Web Push (VAPID) — chave pública em base64url. Gere o par uma única vez com:
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 | tr -d '=' | tr '/+' '_-'
# A chave privada correspondente fica só em secret do servidor e nunca entra no repositório.
VITE_VAPID_PUBLIC_KEY=substitua_pela_chave_publica_vapid
