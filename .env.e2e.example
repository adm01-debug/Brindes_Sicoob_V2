# Credenciais para E2E autenticado em homologação isolada.
# Copie para .env.e2e e preencha. Nunca commite .env.e2e.

E2E_SUPABASE_URL=
E2E_SUPABASE_PROJECT_ID=
E2E_ALLOWED_PROJECT_ID=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_CLEANUP_TOKEN=
E2E_CLEANUP_DRY_RUN=1

E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_TOTP_SECRET=
E2E_DEV_EMAIL=
E2E_DEV_PASSWORD=
E2E_DEV_TOTP_SECRET=

# Opcional: URL do app de homologação; o backend ainda precisa passar na allowlist acima.
# E2E_BASE_URL=https://meu-preview.lovable.app
